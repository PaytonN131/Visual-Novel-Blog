# Copia este archivo como ".env" y rellena los valores.
# NUNCA subas el archivo .env a Git.

PORT=3000

# Contraseña del administrador (mínimo 12 caracteres). Elige una propia.
ADMIN_PASSWORD=

# Cadena aleatoria larga (mínimo 32 caracteres). Para generarla ejecuta:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Tamaño máximo de cada imagen subida, en megabytes.
MAX_UPLOAD_MB=8

# Pon "production" solo cuando publiques la web con HTTPS.
NODE_ENV=development
